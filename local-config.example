# 独立版示例：只能连接 suiyuan-staging 的专用 Neon 数据库。
# 复制为 dev-secrets.local 后，在你自己的电脑上填写真实连接串；严禁提交 Git。
NEON_DSN=postgresql://suiyuan_staging_owner:YOUR_PASSWORD@YOUR_STAGING_HOST.neon.tech/suiyuan_staging?sslmode=require
NEON_SCHEMA=staging_render_preview
STAGING_MODE=1

# 可选：前端首选端口，必须使用 loopback。
VITE_PORT=8000