# TEMPLATE ONLY: replace DNS name and certificate paths before enabling on a staging host.
# All passwords, htpasswd files and TLS private keys must live outside Git and Docker images.
# Access gate is REQUIRED. X-Robots-Tag alone does not protect private preview data.
server {
    listen 443 ssl;
    server_name staging.example.org;

    ssl_certificate     /etc/letsencrypt/live/staging.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;

    # Replace this path with a protected file containing only explicitly invited testers.
    auth_basic "Suiyuan Staging - invited adults only";
    auth_basic_user_file /etc/nginx/private/suiyuan-staging-htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite client-controlled header, NEVER append $proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
